            </button>
            <button
              class="flex-1 py-3 text-sm font-bold transition-colors border-b-2 text-primary border-primary bg-white"
            >
              ข้อมูลส่วนตัว
            </button>
            <button
              class="flex-1 py-3 text-sm font-bold transition-colors border-b-2 text-gray-500 border-transparent hover:text-gray-700 hover:bg-gray-100"
            >

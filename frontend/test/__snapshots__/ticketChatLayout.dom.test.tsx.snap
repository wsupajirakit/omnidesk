          </div>
          <div
            class="p-4 border-t border-dark-700 bg-dark-800/50 flex justify-end"
          >
            <button
              class="px-6 py-2 rounded-xl text-sm font-bold shadow-lg transition-all bg-orange-600 hover:bg-orange-500 text-white shadow-orange-500/20"
            >
              ปิด
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;


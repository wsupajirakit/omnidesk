                width="20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M18 6 6 18"
                />
                <path
                  d="m6 6 12 12"
                />
              </svg>
            </button>
          </div>
          <div
            class="relative flex min-h-0 flex-1 flex-col"
          >
            <div
              class="p-8 overflow-y-auto custom-scrollbar min-h-0 flex-1"
            >
              <p
                class="break-words text-base leading-relaxed text-slate-500 dark:text-slate-400"
              >
                คุณติดดาวครบ 5 กลุ่มแล้ว กรุณาเอาดาวออกก่อนหนึ่งกลุ่มจึงจะติดดาวเพิ่มได้
              </p>
            </div>
          </div>
          <div
            class="shrink-0 flex flex-row-reverse items-center gap-3 p-5 border-t border-slate-100 dark:border-dark-700 bg-slate-50/50 dark:bg-dark-900/50"
          >
            <button
              class="flex-1 px-6 py-3 rounded-xl text-sm font-black uppercase tracking-widest text-white shadow-lg shadow-red-500/20 transition-colors disabled:cursor-not-allowed disabled:opacity-40 disabled:shadow-none bg-primary-600 hover:bg-primary-500 shadow-primary-500/30"
              type="button"
            >
              ตกลง
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;


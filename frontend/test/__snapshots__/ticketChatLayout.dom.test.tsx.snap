                  />
                  <path
                    d="M12 17h.01"
                  />
                </svg>
              </div>
              ติดดาวได้สูงสุด 5 กลุ่ม
            </h3>
            <button
              class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 dark:hover:bg-dark-700 transition-all"
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-x"
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"

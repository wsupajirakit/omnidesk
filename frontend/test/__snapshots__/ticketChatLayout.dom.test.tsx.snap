          <div
            class="flex-1 flex items-center justify-center text-gray-400 text-xs p-6 text-center"
          >
            เลือกเคสเพื่อดูข้อมูลลูกค้า
          </div>
        </div>
      </div>
    </div>
  </div>
</body>"
`;


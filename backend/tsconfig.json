{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Strictness — full strict from day one. The Nest scaffold ships with
     * noImplicitAny/strictBindCallApply disabled; turning them on later means
     * fixing hundreds of files at once, which is exactly the debt this project
     * exists to avoid. Nothing is written yet, so it costs nothing now. */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    /* Index access yields `T | undefined` — catches the exact class of
     * "Cannot read properties of undefined" bugs the legacy JS backend hit. */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "z-test/**/*"],
  "exclude": ["node_modules", "dist"]
}

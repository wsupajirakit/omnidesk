# copy to .env (never commit .env). Values below are placeholders — production refuses them.
NODE_ENV=development
HOST=127.0.0.1
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# member-api
MEMBER_PORT=3301
MEMBER_API_PREFIX=member-api
MEMBER_HMAC_SECRET=change-me-in-env          # = the backend custom tool's api_key (>= 32 chars in production)
MEMBER_HMAC_WINDOW_SEC=300
MEMBER_LOGIN_USERNAME=demo-client
MEMBER_LOGIN_PASSWORD=change-me-in-env
MEMBER_JWT_SECRET=change-me-in-env
MEMBER_ALLOW_IPS=                            # comma list; empty = any (dev only)
MEMBER_ADMIN_TOKEN=                          # empty = POST /__admin/reset does not exist

# walletpay-api
WALLETPAY_PORT=3302
WALLETPAY_FILE_FIELD=slip
WALLETPAY_ALLOW_IPS=
WALLETPAY_ADMIN_TOKEN=

# Copy to .env (docker compose) or .env.local (local run) and fill in real values. Both are git-ignored.
# Boot validates this contract with zod (src/config/env.schema.ts) and refuses
# to start when a required key is missing, so a bad deploy fails immediately
# instead of surfacing as a 500 on the first request that needs the value.

# ── core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DEBUG=1
DEV_MODE=1
BOOTSTRAP_TIMEOUT_MS=5000
# Public origin used when building webhook/callback URLs (ngrok while local)
BASE_URL=

# ── mongo (required) ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/<your-local-db>

# ── redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
REDIS_DB=0

# ── auth (required — no defaults on purpose) ─────────────────────────────────
# JWT_SECRET must match the legacy backend's value during migration, otherwise
# tokens minted by one service are rejected by the other.
JWT_SECRET=<jwt-signing-secret>
JWT_EXPIRES_IN=1h
# Decrypts `enc:`-prefixed secrets stored in Mongo; must match the DB it opens.
ENCRYPTION_KEY=<encryption-key-matching-your-db>

# ── http / cors ──────────────────────────────────────────────────────────────
# The dashboard (frontend) origin(s) allowed to call this API with credentials.
# Set this to YOUR deployed frontend URL. Comma-separate multiple origins.
# REQUIRED in production once the HttpOnly auth cookie is live: empty reflects
# any origin (legacy/dev only), and "*" + credentials is rejected by browsers.
# Example: https://dash.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# ── auth cookie / ws ticket (HttpOnly migration) ─────────────────────────────
# Parent domain the auth cookie is scoped to, so your frontend and API
# subdomains can share it. Leave empty for local / host-only.
# Example: .example.com
COOKIE_DOMAIN=
# Send the auth cookie only over HTTPS. Keep "true" in staging/production;
# set "false" only for local http development.
COOKIE_SECURE=true
# Cookie cross-site policy. Use "lax" when the frontend and API are the same
# site (both under example.com). Use "none" only if they are on different sites
# (then HTTPS + a CSRF token are required).
COOKIE_SAMESITE=lax
# Lifetime (seconds) of a single-use WebSocket connection ticket.
WS_TICKET_TTL_SEC=45

# ── rate limiting ────────────────────────────────────────────────────────────
# ⚠️ ทุกค่าในหมวดนี้ต้อง **ตรงกับ default ใน src/config/env.schema.ts เสมอ**
#    (23/08/2026 เคยไม่ตรงกัน 3 ตัว: MAX 3vs2 · GLOBAL_MAX 600vs300 ·
#     GLOBAL_WINDOW 60vs300 ⇒ คนอ่านไฟล์นี้เข้าใจผิดว่าระบบใช้เลขไหน)
#    แก้ที่ schema เมื่อไหร่ ต้องตามมาแก้ที่นี่ในคอมมิตเดียวกัน
RATE_LIMIT_MAX=2
RATE_LIMIT_WINDOW_SECONDS=30
# [FEAT-20260823-LOGINRL] แกนที่ 1 — เพดานดิบ นับ "ทุก request" ต่อ IP
#   ⚠️ แกนนี้ไม่ใช่ตัวกันเดารหัส (แกน 2-3 ข้างล่างทำหน้าที่นั้น) จึงตั้งสูงพอ
#   ที่ออฟฟิศ IP เดียวหลายแอดมินจะไม่ชนกันเอง — มีหน้าที่กันคนยิงรัวเป็นร้อยครั้ง/นาที
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# [FEAT-20260823-LOGINFAIL] แกนที่ 2 — นับ "เฉพาะรหัสผิด" ต่อ IP
#   กัน flood ที่ยิงจาก IP เดิมแล้วสุ่มชื่อผู้ใช้ไปเรื่อย ๆ (แกน 3 จับไม่ได้
#   เพราะคนละ username = คนละตัวนับ แต่ทุกครั้งคือรหัสผิด)
#   ล็อกอินที่ถูกไม่กินโควตานี้ ⇒ ออฟฟิศ 5 คนพิมพ์ผิดคนละ 2 = 10 ยังต่ำกว่า 15
RATE_LIMIT_LOGIN_FAIL_ENABLED=true
RATE_LIMIT_LOGIN_FAIL_MAX=15
RATE_LIMIT_LOGIN_FAIL_WINDOW_SECONDS=300

# [FEAT-20260823-LOGINUSER] แกนที่ 3 ของ login — นับต่อ "ชื่อผู้ใช้" ไม่ใช่ต่อ IP
#   แกนนี้นับ "ครั้งที่รหัสผิด" ต่อ **บัญชี** ไม่ว่ามาจาก IP ไหน
#   กัน botnet ที่เปลี่ยน IP ทุกครั้งแต่จิ้มบัญชีเดิม · ตัวเลขอิสระจากอีก 2 แกน
#   ปิดทั้งชั้น: RATE_LIMIT_LOGIN_USER_ENABLED=false (ไม่มี Redis call เพิ่มเลย)
RATE_LIMIT_LOGIN_USER_ENABLED=true
RATE_LIMIT_LOGIN_USER_MAX=5
RATE_LIMIT_LOGIN_USER_WINDOW_SECONDS=300
RATE_LIMIT_GLOBAL_ENABLED=false
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=300
RATE_LIMIT_GLOBAL_SHADOW=false

# ── ai ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
MODEL_ID=gemini-3.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_TOP_K=1
GEMINI_TOP_P=0.1
LOG_GEMINI_RESPONSE=0

# ── deepseek (vendor #2) ─────────────────────────────────────────────────────
# ⚠️ NO api key here on purpose: every key is per hook (hook.custom_ai_key).
# A deepseek hook with no key of its own refuses — it never borrows Gemini's.
# This is the model NAME only, same role MODEL_ID plays for Gemini.
DEEPSEEK_MODEL_ID=deepseek-chat
IGNORE_DOC_ID=1

# ── ai translate ─────────────────────────────────────────────────────────────
# [FEAT-20260908-CHATTRANS] ทั้งสามตัวเป็น optional และมี default อยู่แล้ว
#   ⇒ ไม่ตั้งอะไรเลย = ทำงานได้ปกติ และเหมือนเดิมทุกประการ
# ⚠️ ค่าที่เขียนไว้ตรงนี้ต้องตรงกับ default ใน src/config/env.schema.ts เสมอ
#    (กฎเดียวกับหมวด rate limit ข้างบน — เคยไม่ตรงกันมาแล้ว 3 ตัว 23/08/2026)
#
# เพดานจำนวนครั้งของ "งานแปล" โดยเฉพาะ — ไม่ตั้ง = ใช้ค่าเดียวกับ AI_CAP_LIMIT
#   🔴 มีไว้เพื่อให้ยกเพดานงานแปลได้ โดยไม่ไปยกเพดานของบอทที่คุยกับลูกค้า
#      (AI_CAP_LIMIT ถูกอ่านโดย reply / assist summary / translate พร้อมกัน)
#   ปล่อยว่างไว้ = ไม่ตั้ง ≠ ตั้งเป็นตัวเลข — สองอย่างนี้ไม่เหมือนกัน
AI_TRANSLATE_CAP_LIMIT=
# ปุ่ม preview ในกล่องพิมพ์: กดได้กี่ครั้ง ต่อ 1 แอดมิน ต่อ 1 ห้อง ต่อ 1 ช่วงเวลา
AI_TRANSLATE_PREVIEW_MAX=12
AI_TRANSLATE_PREVIEW_WINDOW_SECONDS=60

# [FEAT-20261018-NOWBLOCKENV] ก้อน "วันนี้" ใน prompt AI (เวลา · เวลาทำการ · วันหยุด · เปิด/ปิด)
# ไม่ตั้ง / ว่าง = ปิด (shop-api ใช้แบบเดิม) · สินเชื่อตั้ง on · เปิดได้เฉพาะ on / true / 1
AI_NOW_BLOCK=

# ── realtime (published over redis to the ws gateway) ────────────────────────
WS_ENV=dev

# ── channels ─────────────────────────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET=

# ── outbound integrations ────────────────────────────────────────────────────
EXTERNAL_API_BASE_URL=
EXTERNAL_API_USERNAME=
EXTERNAL_API_PASSWORD=

# ── migrations ───────────────────────────────────────────────────────────────
MIGRATION_TARGET_DB=

# ── handoff worker (dormant unless both are set — fail closed) ───────────────
HANDOFF_WORKER=false
HANDOFF_ALLOWED_DB=

# ── loan site: Custom Tools mint buttons (optional · loan site only) ─────────
# [FEAT-20261016-TOOLMINT] three per company. All three set ⇒ the button mints a
# ready tool; fewer ⇒ it mints the skeleton and the admin fills the rest. The
# password is encrypted into the tool and never sent to the browser. Changing a
# value later does NOT change a tool already minted. shop-api: leave all unset.
LOAN_TOOL_DEMO_BASE_URL=
LOAN_TOOL_DEMO_USERNAME=
LOAN_TOOL_DEMO_PASSWORD=
LOAN_TOOL_ACME_BASE_URL=
LOAN_TOOL_ACME_USERNAME=
LOAN_TOOL_ACME_PASSWORD=
LOAN_TOOL_GLOBEX_BASE_URL=
LOAN_TOOL_GLOBEX_USERNAME=
LOAN_TOOL_GLOBEX_PASSWORD=

# ── proxy gate (app layer) ──────────────────────────────────────────────────
# When set, every request must carry `X-Internal-Secret` with this value — Traefik injects it
# on the console's API route (deploy/traefik/dynamic/routing.yaml). Empty = gate off.
INTERNAL_PROXY_SECRET=

# ── first users (seeded on boot when missing; never overwrites a live password) ─────────────
ACL_SEED_ON_BOOT=true
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me-admin
INIT_DEV_USERNAME=dev
INIT_DEV_PASSWORD=change-me-dev
INIT_SU_USERNAME=su
INIT_SU_PASSWORD=change-me-su

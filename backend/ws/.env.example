PORT=8080
HEARTBEAT_MS=30000
MAX_CLIENTS_PER_ENV=5000
# Redis shared with the API: the API publishes ticket events and mints single-use WS tickets.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
REDIS_DB=0
# Channels the API publishes to (WS_ENV in backend/.env picks dev or prod).
DEV_WS_CHANNEL=ticket_events_dev
PROD_WS_CHANNEL=ticket_events_prod
# Legacy token handshake (the ticket handshake needs no secret here). Any long random strings.
DEV_JWT_SECRET=
PROD_JWT_SECRET=

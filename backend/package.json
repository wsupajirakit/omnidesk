{
  "name": "omnidesk-api",
  "version": "0.0.1",
  "description": "Omnichannel messaging and operations API (NestJS + TypeScript)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"z-test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:cards": "node dist/cli/seed-payment-cards.js",
    "purge:old": "node dist/cli/purge-old-records.js",
    "log:retention": "node dist/cli/set-log-retention.js",
    "menutag:migrate": "node dist/cli/migrate-menu-tags.js",
    "audit:payment-binding": "node dist/cli/audit-payment-binding.js",
    "fix:payment-binding": "node dist/cli/fix-payment-binding.js",
    "seed:tool": "node dist/cli/seed-custom-tool.js",
    "lint": "eslint \"{src,z-test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,z-test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --testPathPatterns=z-test/unit",
    "test:e2e": "jest --testPathPatterns=z-test/e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit",
    "preflight": "node scripts/preflight-deploy.mjs",
    "route-coverage": "node scripts/route-coverage.mjs",
    "seed:demo": "node demo/seed-demo.mjs"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "axios": "^1.19.0",
    "bullmq": "^6.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "mongoose": "^9.9.1",
    "multer": "2.2.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
